# Sao chép thành .env hoặc .env.local (ưu tiên .env.local). Hai file đó KHÔNG commit — chỉ cấu hình trên máy / trên host.
# Xem README.md mục "Deploy — biến môi trường".

# --- Supabase (project: WebsiteThangLongKimViet) ---
# Org: https://supabase.com/dashboard/org/kkgegygcndwmfwlqkner
# Project: https://supabase.com/dashboard/project/yrdqnmsvwovwhepmhigv
NEXT_PUBLIC_SUPABASE_URL=https://yrdqnmsvwovwhepmhigv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hoặc dùng anon key (Project Settings → API) thay cho publishable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Cách 2: tên ngắn (vẫn hỗ trợ) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# --- Cloudflare Worker CDN for public images ---
# All public images (product, news, avatars, …) are served through this CDN
# instead of directly from Supabase Storage.
# To switch domains later, only change this variable — no code changes needed.
NEXT_PUBLIC_IMAGE_CDN=https://cdn.thanglongkimviet.vn

# Optional (server)
# PORT=5190
